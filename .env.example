# ── Aether — environment variables ──────────────────────────────
# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# Anthropic — required (agent classifier + synthesizer)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenSky Network — required for live flight data
# OAuth2 client_credentials from https://opensky-network.org (My OpenSky > API Client)
# Leave blank to fall back to the anonymous OpenSky API (lower rate limit).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AviationStack — optional / unused.
# Airport & airline data are served from bundled OpenFlights CSVs, so no key is needed.
AVIATIONSTACK_API_KEY=

# LangSmith — optional (agent tracing/observability)
# https://smith.langchain.com
LANGSMITH_API_KEY=

# Qdrant vector DB (RAG). Defaults below match `docker compose up`.
# For Qdrant Cloud, set QDRANT_URL to your cluster URL and QDRANT_API_KEY to its key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=flight_docs
